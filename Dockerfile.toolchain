# syntax=docker/dockerfile:1.7

# Rarely rebuilt, source-derived resin manufacturing toolchain.
# Normal service CI consumes a separately published immutable digest of this image.
FROM ubuntu:24.04 AS prusa-builder
ARG PRUSA_SLICER_VERSION=2.9.7
ARG PRUSA_SLICER_COMMIT=450d70dd81c9b8990bc6bc8e690e31f82ddceb11
ARG BUILD_JOBS=4
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential autoconf automake libtool cmake libglu1-mesa-dev libgtk-3-dev \
    libdbus-1-dev libwebkit2gtk-4.1-dev libncurses-dev texinfo ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/prusa3d/PrusaSlicer.git /src/PrusaSlicer \
    && cd /src/PrusaSlicer \
    && git checkout "${PRUSA_SLICER_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${PRUSA_SLICER_COMMIT}" \
    && sed -i 's#https://gmplib.org/download/gmp/gmp-6.2.1.tar.bz2#https://ftp.gnu.org/gnu/gmp/gmp-6.2.1.tar.bz2#' deps/+GMP/GMP.cmake

WORKDIR /src/PrusaSlicer/deps/build
RUN cmake .. -DDEP_WX_GTK3=ON && make -j"${BUILD_JOBS}"

WORKDIR /src/PrusaSlicer/build
RUN cmake .. \
    -DSLIC3R_STATIC=1 \
    -DSLIC3R_GTK=3 \
    -DSLIC3R_GUI=no \
    -DSLIC3R_PCH=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_PREFIX_PATH=/src/PrusaSlicer/deps/build/destdir/usr/local \
    && make -j"${BUILD_JOBS}"

FROM ubuntu:24.04
ARG PRUSA_SLICER_VERSION=2.9.7
ARG PRUSA_SLICER_COMMIT=450d70dd81c9b8990bc6bc8e690e31f82ddceb11
ARG UVTOOLS_VERSION=7.1.2
ARG UVTOOLS_SHA256=4d06ec7e86043c409d81126311c5c8e6f4629eb5bb9d3f092d8ec2401d157c1c

LABEL org.opencontainers.image.title="Workpiece Resin Slicer Toolchain" \
      org.opencontainers.image.source="https://github.com/workpiece-gr/open-resin-slicer-service" \
      workpiece.prusaslicer.version="${PRUSA_SLICER_VERSION}" \
      workpiece.prusaslicer.commit="${PRUSA_SLICER_COMMIT}" \
      workpiece.uvtools.version="${UVTOOLS_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive \
    PRUSA_SLICER_BIN=/opt/prusaslicer/prusa-slicer \
    UVTOOLS_CMD=/opt/uvtools/UVtoolsCmd

# libicu74: the self-contained .NET 10 runtime in UVtools 7 needs ICU at startup.
# UVtools 7.1.2's libcvextern.so links only libz/libstdc++ (no libtiff/libsqlite3 since 7.1.2).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip python3 python3-venv \
    libgl1 libglu1-mesa libgtk-3-0t64 libdbus-1-3 libwebkit2gtk-4.1-0 \
    libicu74 zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=prusa-builder /src/PrusaSlicer/build/src/prusa-slicer /opt/prusaslicer/prusa-slicer
COPY --from=prusa-builder /src/PrusaSlicer/resources /opt/prusaslicer/resources

RUN mkdir -p /opt/uvtools \
    && curl --fail --location --retry 3 \
      "https://github.com/sn4k3/UVtools/releases/download/v${UVTOOLS_VERSION}/UVtools_linux-x64_v${UVTOOLS_VERSION}.zip" \
      -o /tmp/uvtools.zip \
    && echo "${UVTOOLS_SHA256}  /tmp/uvtools.zip" | sha256sum -c - \
    && unzip -q /tmp/uvtools.zip -d /opt/uvtools \
    && rm /tmp/uvtools.zip \
    && chmod +x /opt/uvtools/UVtoolsCmd \
    && test "$(/opt/uvtools/UVtoolsCmd --core-version)" = "${UVTOOLS_VERSION}"

RUN mkdir -p /opt/workpiece-toolchain \
    && printf '%s\n' \
      '{' \
      '  "schema": "workpiece-resin-toolchain-v1",' \
      "  \"prusaslicer_version\": \"${PRUSA_SLICER_VERSION}\"," \
      "  \"prusaslicer_commit\": \"${PRUSA_SLICER_COMMIT}\"," \
      "  \"uvtools_version\": \"${UVTOOLS_VERSION}\"," \
      "  \"uvtools_archive_sha256\": \"${UVTOOLS_SHA256}\"" \
      '}' \
      > /opt/workpiece-toolchain/manifest.json \
    && test -x /opt/prusaslicer/prusa-slicer \
    && test -x /opt/uvtools/UVtoolsCmd
